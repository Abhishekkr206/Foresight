# Local database. For hosted deployment, use the Supabase PostgreSQL URL.
DATABASE_URL=sqlite:///./foresight.db

# Beacon and simulation settings
ENABLE_SIMULATION=true
BEACON_CONFIG_PATH=../beacons_config.json
HEARTBEAT_TIMEOUT_SECONDS=45
CORRELATION_WINDOW_SECONDS=20
EVENT_THRESHOLD=0.45
SAVE_THRESHOLD=0.60
ACI_BASELINE=1.0
GRID_SIZE=4
MAX_AUDIO_BYTES=10000000

# Gemini AI assistant
ASSISTANT_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Supabase database and audio storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=foresight-audio

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000



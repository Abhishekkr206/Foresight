{
  "name": "@youhai/react-bits-mcp-server",
  "version": "1.0.2",
  "description": "MCP (Model Context Protocol) server providing access to 90+ animated React components with TypeScript/JavaScript and CSS/Tailwind variants",
  "main": "index.js",
  "type": "module",
  "bin": {
    "react-bits-mcp": "./index.js",
    "react-bits-mcp-server": "./index.js",
    "youhai-react-bits-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node test.js",
    "generate-data": "node scripts/generateComponentsData.js",
    "update-data": "npm run generate-data && echo 'Component data updated successfully!'",
    "prepublishOnly": "npm run generate-data",
    "postinstall": "npm run generate-data"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "react",
    "components",
    "animation",
    "ui",
    "tailwind",
    "typescript",
    "claude",
    "ai",
    "developer-tools"
  ],
  "author": {
    "name": "React Bits MCP",
    "email": "react-bits@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/react-bits-mcp.git"
  },
  "homepage": "https://github.com/your-username/react-bits-mcp#readme",
  "bugs": {
    "url": "https://github.com/your-username/react-bits-mcp/issues"
  },
  "files": [
    "index.js",
    "src/",
    "data/",
    "scripts/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "node-fetch": "^3.3.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  }
}

*.log

# Downloaded/generated simulation audio (keep README files, not large media)
backend/audio/**/*.wav
backend/audio/**/*.mp3
backend/audio/**/*.ogg
backend/audio/**/*.flac
backend/audio/**/*.m4a
!backend/audio/**/README.md

